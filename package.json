{
  "name": "twofold",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch server/local.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build && node scripts/build-worker.mjs",
    "start": "tsx server/local.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "dotenv": "^16.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.1.0",
    "wrangler": "^4.30.0",
    "drizzle-orm": "^0.44.0",
    "drizzle-kit": "^0.31.0"
  }
}
